---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/hero/Hero.astro";
import Scene from "../components/scene/Scene.astro";
import Built from "../components/built/Built.astro";
import About from "../components/about/About.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Luis Zarate · Full-stack engineer"
  description="Portfolio of Luis Zarate, full-stack engineer. Four projects, each with the numbers measured from its repository."
>
  <Hero />
  {projects.map((entry) => (
    <Scene entry={entry} />
  ))}
  <Built />
  <About />
</Base>
