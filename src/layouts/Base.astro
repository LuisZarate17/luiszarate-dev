---
import "../styles/global.css";
import WorldStyles from "../components/WorldStyles.astro";
import SkipLink from "../components/frame/SkipLink.astro";
import TopBar from "../components/frame/TopBar.astro";
import SceneStrip from "../components/frame/SceneStrip.astro";
import Wipe from "../components/frame/Wipe.astro";
import displayBlack from "@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url";
import sansRegular from "@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** A page that is not content (the 404 page): no canonical URL, and search engines skip it. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// `site` is set in astro.config.mjs; it changes when the domain is connected at launch.
const canonical = new URL(Astro.url.pathname, Astro.site);
// public/og.png, 1200 x 630, written by `npm run share:image`. Share cards need absolute URLs.
const shareImage = new URL("/og.png", Astro.site);
const shareAlt =
  "Luis Zarate, full-stack engineer: the name in large capitals, with four colored plates fanned behind it.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Luis Zarate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={displayBlack} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansRegular} crossorigin />
    <WorldStyles />
    <title>{title}</title>
  </head>
  <body class="bg-bg font-sans text-text antialiased">
    <SkipLink />
    <TopBar />
    <SceneStrip />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Wipe />
  </body>
</html>

<style>
  /* <main> only takes programmatic focus (skip link); a ring around the whole page helps no one. */
  main:focus {
    outline: none;
  }
</style>
