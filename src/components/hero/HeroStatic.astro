---
import Slug from "../scene/Slug.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-field" aria-hidden="true"></div>
  <div class="hero-inner">
    <Slug loc="INT. PORTFOLIO — FULL-STACK ENGINEER" />
    <h1 id="hero-title" class="font-display text-hero uppercase">
      Luis <br />
      Zarate
    </h1>
    <p class="hero-sub text-lead">
      Full-stack engineer. I build systems and measure that they work.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: var(--frame-h);
    padding-block: var(--spacing-scene);
    padding-inline: max(var(--spacing-margin), env(safe-area-inset-left))
      max(var(--spacing-margin), env(safe-area-inset-right));
    background: var(--color-bg);
  }
  .hero-field {
    position: absolute;
    inset: 0;
    z-index: var(--z-below);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: var(--z-base);
    width: 100%;
    max-width: var(--container-frame);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
  }
  .hero-sub {
    max-width: var(--container-measure);
    color: var(--color-text);
  }
</style>
