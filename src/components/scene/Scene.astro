---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Slug from "./Slug.astro";
import { liveLabels, notes } from "./notes";
import { stills } from "./stills";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { id, data } = entry;
const still = stills[id];
const note = notes[id];
const number = `SC ${String(data.order).padStart(2, "0")}`;
const teamProject = data.credit === "team";
const liveLabel = liveLabels[id] ?? "Live demo";
const drawerGroups = ["Stack", ...(note ? ["Notes"] : [])];

/** "50 → 1" is split so the arrow can be drawn (spec 5.7). */
const statParts = (value: string) => value.split("→").map((part) => part.trim());
---

<section class="scene" id={id} data-world={id} aria-labelledby={`${id}-title`}>
  <div class="scene-grid">
    <div class="scene-head">
      <Slug no={number} loc={data.slug} />
      <p class:list={["credit-badge font-mono text-meta uppercase", { team: teamProject }]}>
        {teamProject ? "Team project" : "Solo project"}
      </p>
      <h2 id={`${id}-title`}>
        <span class="scene-kicker font-display text-heading uppercase">{data.title}</span>
        <span class="sr-only">: </span>
        <span class="scene-title font-display text-title uppercase">
          {data.headline.map((line, i) => (
            <>
              {line}
              {i < data.headline.length - 1 && (
                <>
                  {" "}
                  <br />
                </>
              )}
            </>
          ))}
        </span>
      </h2>
      <p class="scene-logline text-lead">{data.logline}</p>
    </div>

    <div class="scene-proof">
      <figure class="sim">
        <div class="sim-stage">
          {still && (
            <div class="sim-still">
              <Picture
                src={still.src}
                alt={still.alt}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[480, 720, 960, 1256]}
                sizes="(min-width: 64rem) 39.25rem, calc(100vw - 2rem)"
                pictureAttributes={{ class: "sim-picture" }}
                style={`object-position: ${still.position ?? "center"}`}
                class="sim-image"
              />
            </div>
          )}
        </div>
        {still && <figcaption class="text-small">{still.caption}</figcaption>}
      </figure>

      {data.metrics.length > 0 && (
        <dl class="stats">
          {data.metrics.map((metric) => {
            const parts = statParts(metric.value);
            return (
              <div class="stat">
                <dt class="text-small">{metric.label}</dt>
                <dd class="font-display text-stat uppercase">
                  {parts.length === 2 ? (
                    <>
                      <span>{parts[0]}</span>
                      <svg
                        class="stat-arrow"
                        viewBox="0 0 12 12"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path
                          d="M0 6h11M6.5 1.5 11 6l-4.5 4.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          vector-effect="non-scaling-stroke"
                        />
                      </svg>
                      <span class="sr-only"> to </span>
                      <span>{parts[1]}</span>
                    </>
                  ) : (
                    metric.value
                  )}
                </dd>
              </div>
            );
          })}
        </dl>
      )}
    </div>

    <div class="scene-meta">
      <ul class="stack font-mono text-meta uppercase" aria-label="Stack">
        {data.stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <div class="scene-links">
        {data.live ? (
          <>
            <a class="btn btn-primary text-control" href={data.live} rel="noopener noreferrer">
              {liveLabel}
              <svg class="btn-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
            <a class="btn btn-ghost text-control" href={data.repo} rel="noopener noreferrer">
              Repository
              <svg class="btn-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          </>
        ) : (
          <a class="btn btn-primary text-control" href={data.repo} rel="noopener noreferrer">
            Repository
            <svg class="btn-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        )}
      </div>

      <p class="credit text-small">
        <span class="credit-label font-mono text-meta uppercase">Credit</span>
        {data.role}
      </p>

      <details class="drawer">
        <summary class="text-control">
          <span class="drawer-label">
            Details
            <span class="drawer-groups font-mono text-meta uppercase">
              {drawerGroups.join(" · ")}
            </span>
          </span>
        </summary>
        <div class="drawer-panel">
          <div class="drawer-group">
            <h3>Stack</h3>
            <p class="text-body">{data.stack.join(", ")}.</p>
          </div>
          {note && (
            <div class="drawer-group">
              <h3>Notes</h3>
              <p class="text-body">{note}</p>
            </div>
          )}
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: var(--frame-h);
    padding-block: var(--spacing-scene);
    padding-inline: max(var(--spacing-margin), env(safe-area-inset-left))
      max(var(--spacing-margin), env(safe-area-inset-right));
    background: var(--color-bg);
    color: var(--color-text);
  }

  .scene-grid {
    width: 100%;
    max-width: var(--container-frame);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: calc(var(--spacing) * 6);
  }

  /* ---- head ---- */
  .scene-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
  }
  .scene-head > :global(.slug) {
    max-width: 100%;
  }
  .credit-badge {
    margin-top: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
  }
  .credit-badge.team {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  h2 {
    margin-top: calc(var(--spacing) * 4);
  }
  .scene-kicker {
    display: block;
    color: var(--color-accent);
  }
  .scene-title {
    display: block;
    margin-top: calc(var(--spacing) * 2);
    color: var(--color-text);
    text-wrap: balance;
  }
  .scene-logline {
    margin-top: calc(var(--spacing) * 4);
    max-width: var(--container-measure);
    text-wrap: pretty;
  }

  /* ---- proof ---- */
  .scene-proof {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sim-stage {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }
  .sim-still,
  .sim-still :global(.sim-picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sim-still :global(.sim-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: calc(var(--spacing) * 3);
    max-width: var(--container-measure-wide);
    color: var(--color-muted);
  }

  .stats {
    margin-top: calc(var(--spacing) * 8);
    border-bottom: 1px solid var(--color-line);
  }
  .stat {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--spacing-gutter);
    padding-block: calc(var(--spacing) * 3);
    border-top: 1px solid var(--color-line);
  }
  .stat dd {
    order: -1;
    white-space: nowrap;
  }
  .stat dt {
    max-width: 26ch;
    color: var(--color-muted);
  }
  .stat-arrow {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-inline: 0.15em;
  }

  /* ---- meta ---- */
  .scene-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    color: var(--color-muted);
  }
  .stack li + li::before {
    content: "·";
    margin-inline: calc(var(--spacing) * 2);
  }
  .scene-links {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    margin-top: calc(var(--spacing) * 6);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 2);
    min-height: calc(var(--spacing) * 12);
    padding-inline: calc(var(--spacing) * 5);
    border: 1px solid;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition-property: color, background-color, border-color;
    transition-duration: var(--dur-ui);
    transition-timing-function: var(--ease-ui);
  }
  .btn-icon {
    width: calc(var(--spacing) * 3);
    height: calc(var(--spacing) * 3);
    flex: none;
  }
  .btn-primary {
    background: var(--color-fill);
    color: var(--color-on-fill);
    border-color: var(--color-accent);
  }
  .btn-ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-text);
  }
  .btn-primary:hover {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .btn-ghost:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .btn:active {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .credit {
    margin-top: calc(var(--spacing) * 4);
    max-width: var(--container-measure-wide);
    color: var(--color-text);
  }
  .credit-label {
    margin-right: calc(var(--spacing) * 2);
    color: var(--color-muted);
  }

  /* ---- drawer ---- */
  .drawer {
    margin-top: calc(var(--spacing) * 4);
  }
  .drawer summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--spacing) * 12);
    border-block: 1px solid var(--color-line);
    cursor: pointer;
    list-style: none;
  }
  .drawer summary::-webkit-details-marker {
    display: none;
  }
  .drawer summary::after {
    content: "+";
  }
  .drawer[open] > summary::after {
    content: "\2212";
  }
  .drawer[open] > summary {
    border-bottom-color: transparent;
  }
  .drawer summary:hover {
    background: var(--color-surface);
  }
  .drawer summary:active {
    background: var(--color-line);
  }
  .drawer summary:focus-visible {
    outline-offset: -4px;
  }
  .drawer-groups {
    display: none;
    margin-left: calc(var(--spacing) * 3);
    color: var(--color-muted);
  }
  .drawer-panel {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
    padding-block: calc(var(--spacing) * 6);
    border-bottom: 1px solid var(--color-line);
  }
  .drawer-group h3 {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--text-body--line-height);
  }
  .drawer-group p {
    max-width: var(--container-measure);
  }
  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] > .drawer-panel {
      animation: var(--animate-reveal);
    }
  }

  /* ---- 640 and up ---- */
  @media (min-width: 40rem) {
    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-gutter);
      border-bottom: 0;
    }
    .stat dd {
      order: 0;
    }
    .stat {
      display: flex;
      flex-direction: column-reverse;
      justify-content: flex-end;
      gap: calc(var(--spacing) * 2);
      padding-block: calc(var(--spacing) * 3) 0;
    }
    .scene-links {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .drawer-groups {
      display: inline;
    }
  }

  /* ---- 1024 and up ---- */
  @media (min-width: 64rem) {
    .scene-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "head proof"
        "meta proof";
      grid-template-rows: auto 1fr;
      column-gap: var(--spacing-gutter);
    }
    .scene-head {
      grid-area: head;
      grid-template-columns: minmax(0, 1fr) auto;
      align-content: start;
      align-items: center;
    }
    .scene-head > :global(.slug) {
      grid-column: 1;
    }
    .credit-badge {
      grid-column: 2;
      grid-row: 1;
      margin-top: 0;
      justify-self: end;
    }
    h2,
    .scene-logline {
      grid-column: 1 / -1;
    }
    h2 {
      margin-top: calc(var(--spacing) * 3);
    }
    .scene-logline {
      margin-top: calc(var(--spacing) * 6);
    }
    .scene-proof {
      grid-area: proof;
    }
    .scene-meta {
      grid-area: meta;
      align-self: end;
    }
    .sim-stage {
      aspect-ratio: 3 / 2;
    }
    .stats {
      margin-top: calc(var(--spacing) * 6);
    }
    .scene:has(.drawer[open]) .scene-proof {
      position: sticky;
      top: calc(var(--bar-top) + var(--spacing-scene));
      align-self: start;
    }
  }
</style>
