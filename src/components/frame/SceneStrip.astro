---
import { getCollection } from "astro:content";

/**
 * Bottom letterbox bar with the scene strip and counter (spec 5.1, 5.5).
 * One item per project, by `order`; section ids are the entry ids.
 */
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, "0");
const total = projects.length;
---

<nav class="frame-bar frame-bar--bottom" aria-label="Scenes">
  <ol class="strip">
    {projects.map(({ id, data }, i) => (
      <li>
        <a href={`#${id}`} data-world={id} aria-label={`Scene ${i + 1}: ${data.title}`}>
          <span class="strip-no">{pad(i + 1)}</span>
          <span class="strip-name">{data.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <span class="counter" aria-hidden="true">
    <span id="strip-counter-current">01</span> / {pad(total)}
  </span>
</nav>

<style>
  .frame-bar {
    position: fixed;
    inset-inline: 0;
    z-index: var(--z-bars);
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--color-bar);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    letter-spacing: var(--text-meta--letter-spacing);
    text-transform: uppercase;
  }
  .frame-bar--bottom {
    bottom: 0;
    height: var(--bar-bottom);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-inline: max(0.5rem, env(safe-area-inset-left, 0px))
      max(0.5rem, env(safe-area-inset-right, 0px));
  }
  .strip {
    display: flex;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Phone: the current item takes the free space, every other item is 44 wide. */
  .strip li {
    display: flex;
    flex: 0 0 44px;
    min-width: 0;
  }
  .strip li:has(a[aria-current]) {
    flex: 1 1 0;
  }
  a {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    color: var(--color-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-text);
  }
  a:focus-visible {
    color: var(--color-text);
    outline-offset: -4px;
  }
  a:active {
    background: var(--color-line);
  }
  a[aria-current] {
    color: var(--color-accent);
    box-shadow: inset 0 2px 0 currentColor;
  }
  .strip-no {
    font-size: 0.875rem;
  }
  .strip-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  a:not([aria-current]) .strip-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .counter {
    display: none;
  }

  @media (min-width: 64rem) {
    .frame-bar--bottom {
      padding-inline: max(1.5rem, env(safe-area-inset-left, 0px))
        max(1.5rem, env(safe-area-inset-right, 0px));
    }
    .strip {
      flex: 0 1 auto;
    }
    .strip li,
    .strip li:has(a[aria-current]) {
      flex: 0 0 auto;
    }
    a {
      width: auto;
      padding-inline: 16px;
    }
    .strip-no {
      font-size: var(--text-meta);
    }
    .strip-name,
    a:not([aria-current]) .strip-name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      font-size: var(--text-strip);
      letter-spacing: var(--text-strip--letter-spacing);
    }
    .counter {
      display: flex;
      align-items: center;
      white-space: pre;
    }
  }
</style>

<script>
  /** Tracks the current scene with an observer collapsed to the frame's midline (spec 5.5). */
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".strip a")];
  const counter = document.getElementById("strip-counter-current");
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const sections = [...document.querySelectorAll<HTMLElement>("main > section")];

  function setCurrent(id: string | null) {
    const current = id ? (byId.get(id) ?? null) : null;
    for (const a of links) {
      if (a === current) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    }
    if (counter && current) {
      counter.textContent = String(links.indexOf(current) + 1).padStart(2, "0");
    }
  }

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setCurrent(entry.target.id || null);
        }
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
