---
// The simulation of each project, one block per id. Astro needs a static import for every
// component it hydrates, so this cannot be a lookup table. Each simulation adds its import
// and its block under its own marker, and its caption in captions.ts.
// import: bifrost
import { BifrostSim } from "./bifrost/BifrostSim";

// import: cougar-connect
import { CougarSim } from "./cougar/CougarSim";

// import: labq
import { LabQSim } from "./labq/LabQSim";

// import: mastery-pilot
import { MasterySim } from "./mastery/MasterySim";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

{/* bifrost */}
{id === "bifrost" && <BifrostSim client:visible />}

{/* cougar-connect */}
{id === "cougar-connect" && <CougarSim client:visible />}

{/* labq */}
{id === "labq" && <LabQSim client:visible />}

{/* mastery-pilot */}
{id === "mastery-pilot" && <MasterySim client:visible />}
